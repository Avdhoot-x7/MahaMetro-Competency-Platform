# MySQL 8.0 Production Tuning Configuration for Maha Metro Platform
# File location: /etc/mysql/conf.d/mahametro.cnf
# Sized for 25,000 staff profiles and peak candidate assessment windows

[mysqld]
# Network & Concurrency
bind-address               = 127.0.0.1
port                       = 3306
max_connections            = 600
max_connect_errors         = 100000
connect_timeout            = 10
wait_timeout               = 600
interactive_timeout        = 600
thread_cache_size          = 128
table_open_cache           = 4000
table_definition_cache     = 2000

# Character Set & Collation (Standard Indian/International Unicode)
character-set-server       = utf8mb4
collation-server           = utf8mb4_unicode_ci
default_time_zone          = '+00:00'

# InnoDB Buffer Pool Tuning (Allocate ~75% of server RAM on dedicated DB host)
innodb_buffer_pool_size    = 12G
innodb_buffer_pool_instances = 8
innodb_log_file_size       = 1G
innodb_log_buffer_size     = 64M

# High-concurrency throughput optimization for assessment autosaves
# Flush log buffer every second to disk rather than synchronously on every write
innodb_flush_log_at_trx_commit = 2
innodb_flush_method        = O_DIRECT
innodb_file_per_table      = 1
innodb_stats_on_metadata   = 0

# IO Capacity (Tuned for modern NVMe SSD storage)
innodb_io_capacity         = 2000
innodb_io_capacity_max     = 4000
innodb_read_io_threads     = 8
innodb_write_io_threads    = 8

# Temp Table Memory Allocation
tmp_table_size             = 128M
max_heap_table_size        = 128M

# Logging & Performance Diagnostics
slow_query_log             = 1
slow_query_log_file        = /var/log/mysql/mysql-slow.log
long_query_time            = 1.0
log_queries_not_using_indexes = 0

[client]
default-character-set      = utf8mb4

[mysql]
default-character-set      = utf8mb4
