# ---- copy to .env and change every value marked CHANGE ----
ENVIRONMENT=production
SECRET_KEY=CHANGE-to-64-random-characters
DB_PASSWORD=CHANGE-db-password
KEYCLOAK_ADMIN_PASSWORD=CHANGE-keycloak-admin-password
SSO_HOSTNAME=https://sso.mahametro.org
HTTPS_ONLY_COOKIES=true
DEMO_MODE=false

# Sign-in: oidc = Keycloak SSO, portal_jwt = signed hand-off from the Maha Metro portal, local = break-glass passwords
AUTH_MODES=oidc,portal_jwt,local
LOCAL_LOGIN_ROLES=superadmin,cell

OIDC_ISSUER=https://sso.mahametro.org/realms/mahametro
OIDC_CLIENT_ID=competency-portal
OIDC_CLIENT_SECRET=CHANGE-client-secret-from-keycloak
OIDC_REDIRECT_URI=https://competency.mahametro.org/auth/callback
# claim that carries the employee ID (map the AD/LDAP attribute 'employeeID' or the SAP personnel number to it)
OIDC_EMP_ID_CLAIM=employee_id
OIDC_FALLBACK_CLAIM=preferred_username
OIDC_ROLES_CLAIM=groups
# Keycloak/AD group -> application role
OIDC_ROLE_MAP=CoE-Assessment-Cell=cell;Competency-HoD=hod;Competency-Management=management;Competency-SME=sme;Competency-Reviewer=reviewer;Competency-Admin=superadmin
OIDC_AUTO_CREATE=false

# Optional: the portal signs a 2-minute JWT {sub: employee ID, iat, exp, aud} and links to /auth/portal?token=...
PORTAL_JWT_SECRET=
PORTAL_JWT_PUBLIC_KEY_FILE=
PORTAL_JWT_ISSUER=
PORTAL_JWT_AUDIENCE=competency-portal

# Nightly jobs (scheduler service)
IMPORT_DIR=/data/import
BACKUP_DIR=/data/import/backups
NIGHTLY_AT=01:30
MAX_UPLOAD_MB=50
