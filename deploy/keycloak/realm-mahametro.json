{
  "realm": "mahametro",
  "enabled": true,
  "displayName": "Maha Metro",
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "groups": [
    {"name": "CoE-Assessment-Cell"}, {"name": "Competency-HoD"}, {"name": "Competency-Management"},
    {"name": "Competency-SME"}, {"name": "Competency-Reviewer"}, {"name": "Competency-Admin"}
  ],
  "clients": [
    {
      "clientId": "competency-portal",
      "name": "CoE Competency Assessment",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "CHANGE-client-secret-from-keycloak",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://competency.mahametro.org/auth/callback"],
      "webOrigins": ["https://competency.mahametro.org"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "protocolMappers": [
        {"name": "groups", "protocol": "openid-connect", "protocolMapper": "oidc-group-membership-mapper",
         "config": {"claim.name": "groups", "full.path": "false", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"}},
        {"name": "employee_id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper",
         "config": {"user.attribute": "employee_id", "claim.name": "employee_id", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"}}
      ]
    }
  ]
}
